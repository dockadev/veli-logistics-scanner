{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VELI Logistics Tarayıcı",
  "version": "1.0.0",
  "identifier": "com.dockadev.veli-scanner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VELI Logistics Tarayıcı",
        "width": 720,
        "height": 780,
        "minWidth": 560,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}